---
import SectionHead from './SectionHead.astro';
import { profile, stats } from '../data/cv';
---

<section class="section" id="about" aria-labelledby="about-title" data-section>
  <div class="wrap">
    <SectionHead index="01" title="About" id="about-title" />
    <div class="about">
      <div class="about__text">
        {profile.summary.map((paragraph) => <p data-reveal>{paragraph}</p>)}
      </div>
      <div data-reveal>
        <dl class="stats">
          {
            stats.map((stat) => (
              <div class="stat">
                <dt class="stat__label">{stat.label}</dt>
                <dd class="stat__value">{stat.prefix}<span data-count={stat.value}>{stat.value}</span>{stat.suffix}</dd>
              </div>
            ))
          }
        </dl>
        <p class="stats__note">Measured results from projects delivered at Fiverr.</p>
      </div>
    </div>
  </div>
</section>
