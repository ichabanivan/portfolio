---
import SectionHead from './SectionHead.astro';
import { experience } from '../data/cv';
---

<section class="section" id="experience" aria-labelledby="experience-title" data-section>
  <div class="wrap">
    <SectionHead index="02" title="Professional Experience" id="experience-title" />
    <div class="timeline" data-timeline>
      <div class="timeline__line" data-timeline-line aria-hidden="true"></div>
      {
        experience.map((role) => (
          <article class="role" data-reveal>
            <div class="role__meta">
              <p class="role__dates">
                <time datetime={role.start.iso}>{role.start.label}</time>
                {' - '}
                {role.end.iso ? (
                  <time datetime={role.end.iso}>{role.end.label}</time>
                ) : (
                  role.end.label
                )}
              </p>
              <p class="role__location">{role.location}</p>
            </div>
            <div class="role__body">
              <h3 class="role__company">{role.company}</h3>
              <p class="role__title">{role.title}</p>
              {role.summary && <p class="role__summary">{role.summary}</p>}
              {role.tech && (
                <p class="role__tech">
                  <strong>Technologies:</strong> {role.tech}
                </p>
              )}
              {role.bullets && (
                <>
                  <h4 class="role__label">Responsibilities</h4>
                  <ul class="bullets">
                    {role.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </>
              )}
              {role.projects && (
                <div class="projects">
                  {role.projects.map((project) => (
                    <div class="project">
                      <h4 class="project__name">{project.name}</h4>
                      <p class="project__description">{project.description}</p>
                      {project.tech && (
                        <p class="project__meta">
                          <strong>Technologies:</strong> {project.tech}
                        </p>
                      )}
                      {project.responsibilities && (
                        <p class="project__meta">
                          <strong>Responsibilities:</strong> {project.responsibilities}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
