---
import { profile } from '../data/cv';

interface Props {
  cvHref: string | null;
}

const { cvHref } = Astro.props;
const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__logo" href="#top" aria-label={`${profile.name}, back to top`}>
      I<span>/</span>C
    </a>
    <button
      class="nav__toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span></span><span></span>
    </button>
    <nav class="nav" id="site-nav" aria-label="Sections">
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a class="nav__link" href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        cvHref && (
          <a class="btn btn--small btn--primary" href={cvHref} download>
            Download CV
          </a>
        )
      }
    </nav>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>
