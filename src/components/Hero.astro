---
import { Image } from 'astro:assets';
import photo from '../assets/me.jpg';
import { profile } from '../data/cv';

interface Props {
  cvHref: string | null;
}

const { cvHref } = Astro.props;

// Strip geometry carried over from the original design (left offset and width in % of the stage).
// --t / --b are the top and bottom edges at rest; the script moves them with the pointer.
const strips = [
  { l: 14.4, w: 10.6, t: 16.7, b: 46.7 },
  { l: 28, w: 18.9, t: 7.1, b: 82.1 },
  { l: 47.2, w: 12.9, t: 15, b: 90 },
  { l: 60.4, w: 18.9, t: 13.3, b: 98.3 },
  { l: 79.7, w: 6.1, t: 26.3, b: 91.3 },
];
const style = (s: (typeof strips)[number]) => `--l:${s.l};--w:${s.w};--t:${s.t};--b:${s.b}`;
---

<section class="hero" id="top" data-hero>
  <div class="hero__text">
    <h1 class="hero__name" data-hero-name>
      <span class="hero__line">{profile.firstName}</span>
      <span class="hero__line">{profile.lastName}</span>
    </h1>
    <p class="hero__title" data-hero-item>{profile.title}</p>
    <address class="hero__contact" data-hero-item>
      <span>{profile.location}</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      {profile.phone && <a href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a>}
      <a href={profile.linkedin} rel="me noopener">LinkedIn</a>
    </address>
    <div class="hero__actions" data-hero-item>
      <a class="btn btn--primary" href="#experience">View experience</a>
      <a class="btn" href={`mailto:${profile.email}`}>Get in touch</a>
      {
        cvHref && (
          <a class="btn" href={cvHref} download>
            Download CV
          </a>
        )
      }
    </div>
  </div>

  <div class="stage" data-stage>
    {
      strips.map((s, i) => (
        <div class="strip" style={style(s)} data-strip aria-hidden={i === 0 ? undefined : 'true'}>
          <Image
            src={photo}
            alt={i === 0 ? `Portrait of ${profile.name}` : ''}
            widths={[480, 800, 1200]}
            sizes="(max-width: 899px) 100vw, 58vw"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : undefined}
            quality={78}
          />
        </div>
      ))
    }
    <div class="strip strip--accent" style="--l:89.5;--w:1;--t:30;--b:74" data-strip aria-hidden="true"></div>
  </div>
</section>
