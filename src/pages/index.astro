---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header';
import Hero from '../components/Hero';
import About from '../components/About';
import Marquee from '../components/Marquee';
import Experience from '../components/Experience';
import Skills from '../components/Skills';
import { Education, AdditionalInformation } from '../components/Education';
import Contact from '../components/Contact';
import Lightbox from '../components/Lightbox';
import { getDocumentImages, logos } from '../lib/documents';
import portrait from '../assets/portrait.jpg';
import { profile } from '../data/cv';

// The Download CV buttons appear once public/Ivan-Chaban-CV.pdf exists.
const CV_FILE = 'Ivan-Chaban-CV.pdf';
const cvHref = existsSync(join(process.cwd(), 'public', CV_FILE))
  ? `${import.meta.env.BASE_URL}${CV_FILE}`
  : null;

// Optimised at build time, then handed to the React hero as plain props.
const image = await getImage({ src: portrait, widths: [480, 800, 1200], format: 'webp', quality: 78 });
const photo = {
  src: image.src,
  srcSet: image.srcSet.attribute,
  width: portrait.width,
  height: portrait.height,
};

// Certificate and diploma scans, resized at build time
const documents = await getDocumentImages();

const title = `${profile.name} | ${profile.title} (React, TypeScript, Node.js)`;
const description =
  'Ivan Chaban is a Senior Software Engineer at Fiverr based in Poznań, Poland. React, TypeScript, Node.js, NestJS and Next.js. Experience, technical skills, education and contact details.';
---

<Base title={title} description={description}>
  <!--
    Components are React. Only the interactive pieces are hydrated: the hero (client:load) and
    the document modal (client:idle). Everything else is static HTML with no client-side React.
  -->
  <Header />
  <main id="main">
    <Hero client:load photo={photo} cvHref={cvHref} />
    <About />
    <Marquee />
    <Experience logos={logos} />
    <Skills />
    <Education documents={documents} />
    <AdditionalInformation />
    <Contact cvHref={cvHref} year={new Date().getFullYear()} />
  </main>
  <Lightbox client:idle />
</Base>
